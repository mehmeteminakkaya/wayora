// Veri modeli taslağı: docs/ARCHITECTURE.md → "Veri modeli".
// Tablolar ilgili story'lerle ekleniyor (W-12: Preference, W-13: Trip + TripDay, W-15: Activity).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  preference   Preference?
  trips        Trip[]
}

enum BudgetLevel {
  LOW
  MEDIUM
  HIGH
}

enum Pace {
  RELAXED
  BALANCED
  PACKED
}

enum TravelStyle {
  SOLO
  COUPLE
  FAMILY
  FRIENDS
}

// W-12: kullanıcı başına tek kayıt. İlgi alanı değerleri API'de doğrulanıyor (api/src/routes/preferences.ts).
model Preference {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests   String[]
  budgetLevel BudgetLevel
  pace        Pace
  travelStyle TravelStyle?
  updatedAt   DateTime     @updatedAt
}

enum TripStatus {
  DRAFT
  PLANNED
}

enum Currency {
  TRY
  EUR
  USD
}

// W-13. Tarihler saat olmadan (@db.Date) tutulur; saat dilimi kayması olmasın diye.
model Trip {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  destination String
  startDate   DateTime   @db.Date
  endDate     DateTime   @db.Date
  budget      Int?
  currency    Currency   @default(TRY)
  status      TripStatus @default(DRAFT)
  days        TripDay[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

// Gezinin her günü için bir kayıt; dayIndex 1'den başlar
model TripDay {
  id         String     @id @default(uuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex   Int
  date       DateTime   @db.Date
  notes      String?
  activities Activity[]

  @@unique([tripId, dayIndex])
}

enum ActivityCategory {
  SIGHTSEEING
  MUSEUM
  FOOD
  NATURE
  SHOPPING
  NIGHTLIFE
  TRANSPORT
  OTHER
}

// W-15: elle eklenen aktivite. order gün içindeki sıra (Sprint 4'te sürükle-bırak).
// Saatler 'HH:MM' metni; tahmini maliyet gezinin para biriminde. placeId Sprint 2'de (W-22) eklenecek.
model Activity {
  id            String           @id @default(uuid())
  tripDayId     String
  tripDay       TripDay          @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  category      ActivityCategory @default(OTHER)
  startTime     String?
  endTime       String?
  estimatedCost Int?
  notes         String?
  createdAt     DateTime         @default(now())

  @@index([tripDayId])
}
