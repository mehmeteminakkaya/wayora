# Bu dosya `npm run setup` ile api/.env olarak kopyalanır. .env asla commit'lenmez.

# Yerel geliştirme: Prisma'nın kendi Postgres'i (`npm run db:start -w api`), hesap gerekmez.
# Bulut veritabanı (Neon / Supabase) kullanacaksanız sadece bu satırı değiştirin.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

API_PORT=4000

# Virgülle ayrılmış izinli frontend adresleri
CORS_ORIGIN="http://localhost:5180"

# Oturum çerezini imzalayan anahtar (en az 32 karakter). Geliştirmede boş bırakılabilir;
# üretimde zorunlu. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# İleride (Sprint 2–3):
# GOOGLE_PLACES_API_KEY=
# LLM_API_KEY=
