// Wayora veri modeli — docs/ARCHITECTURE.md ve docs/specs/001-mvp/spec.md ile hizalıdır.
// Sprint 0'da User vardı; MVP ile tercihler, geziler, günler, aktiviteler ve yer önbelleği eklendi.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  preference   Preference?
  trips        Trip[]
  travelerProfile TravelerProfile?
  connectionsSent TravelConnection[] @relation("ConnectionRequester")
  connectionsReceived TravelConnection[] @relation("ConnectionRecipient")
  messagesSent ConnectionMessage[] @relation("MessageSender")
  blocksMade   BlockedUser[] @relation("UserBlocks")
  blocksReceived BlockedUser[] @relation("BlockedBy")
  reportsMade  SafetyReport[] @relation("ReportsMade")
  reportsReceived SafetyReport[] @relation("ReportsReceived")
}

model Preference {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests   String[] @default([])
  budgetLevel String   @default("mid") // low | mid | high
  travelStyle String   @default("balanced") // relaxed | balanced | packed
  pace        String   @default("moderate") // slow | moderate | fast
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Trip {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  destination String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  budget      Decimal?  @db.Decimal(10, 2)
  currency    String    @default("EUR")
  status      String    @default("draft") // draft | generating | planned | failed
  tips        String[]  @default([])
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  days        TripDay[]
  connections TravelConnection[]

  @@index([userId])
}

model TripDay {
  id         String     @id @default(uuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex   Int
  date       DateTime   @db.Date
  notes      String?
  activities Activity[]

  @@unique([tripId, dayIndex])
  @@index([tripId])
}

model Activity {
  id            String   @id @default(uuid())
  tripDayId     String
  tripDay       TripDay  @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  title         String
  category      String   @default("other") // museum | food | nature | landmark | shopping | other
  startTime     String? // "09:00"
  endTime       String? // "11:00"
  estimatedCost Decimal? @db.Decimal(10, 2)
  placeId       String?
  place         Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tripDayId])
}

// Google Places sonuçlarının önbelleği (kota/maliyet). Offline katalog da bu tabloya yazılır.
model Place {
  id            String     @id @default(uuid())
  googlePlaceId String     @unique
  name          String
  lat           Float
  lng           Float
  address       String?
  rating        Float?
  types         String[]   @default([])
  cachedAt      DateTime   @default(now())
  activities    Activity[]
}

// Keşif rehberi: 10 şehir ve şehir başına detaylı deneyim kataloğu.
// Kaynak veri api/src/data/city-catalog.ts; sunucu açılışında idempotent seed edilir.
model City {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  country     String
  summary     String
  bestSeason  String?
  currency    String           @default("EUR")
  sortOrder   Int              @default(0)
  experiences CityExperience[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CityExperience {
  id              String   @id @default(uuid())
  cityId          String
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  slug            String
  googlePlaceId   String   @unique
  name            String
  category        String   @default("other") // museum | food | nature | landmark | shopping | other
  neighborhood    String?
  address         String?
  rating          Float?
  durationMinutes Int
  estimatedCost   Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR")
  priceNote       String?
  description     String
  tags            String[] @default([])
  openingHours    String?
  bookingUrl      String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cityId, slug])
  @@index([cityId, category])
  @@index([cityId, sortOrder])
}

// Yol Arkadaşları: kullanıcıların açıkça görünür olduğu sosyal eşleşme katmanı.
model TravelerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  bio             String
  languages       String[] @default([])
  hostingAvailable Boolean @default(false)
  hostingNote     String?
  visible         Boolean  @default(false)
  safetyAcceptedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visible])
}

model TravelConnection {
  id          String   @id @default(uuid())
  requesterId String
  recipientId String
  tripId      String?
  status      String   @default("pending") // pending | accepted | declined | cancelled
  message     String?
  requester   User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  messages    ConnectionMessage[]
  reports     SafetyReport[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requesterId, status])
  @@index([recipientId, status])
}

model ConnectionMessage {
  id           String   @id @default(uuid())
  connectionId String
  senderId     String
  body         String
  connection   TravelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender       User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([connectionId, createdAt])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model SafetyReport {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  connectionId   String?
  reason         String
  details        String?
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  connection     TravelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([reportedUserId, createdAt])
}
