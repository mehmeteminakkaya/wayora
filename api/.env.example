# Bu dosya `npm run setup` ile api/.env olarak kopyalanır. .env asla commit'lenmez.

# Yerel geliştirme: Prisma'nın kendi Postgres'i (`npm run db:start -w api`), hesap gerekmez.
# Bulut veritabanı (Neon / Supabase) kullanacaksanız sadece bu satırı değiştirin.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# `prisma migrate dev` için geçici veritabanı. Yerel `prisma dev` kullanıyorsanız boş bırakın
# (prisma.config.ts otomatik olarak localhost:51215'i kullanır). Bulut veritabanında boş bir veritabanı verin.
# SHADOW_DATABASE_URL=

API_PORT=4000

# Virgülle ayrılmış izinli frontend adresleri
CORS_ORIGIN="http://localhost:5180"

# İleride (Sprint 2–3):
# GOOGLE_PLACES_API_KEY=
# LLM_API_KEY=
