# Bu dosya `npm run setup` ile api/.env olarak kopyalanır. .env asla commit'lenmez.

# Yerel geliştirme: Prisma'nın kendi Postgres'i (`npm run db:start -w api`), hesap gerekmez.
# Bulut veritabanı (Neon / Supabase) kullanacaksanız sadece bu satırı değiştirin.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# `prisma migrate dev` için geçici veritabanı. Yerel `prisma dev` kullanıyorsanız boş bırakın
# (prisma.config.ts otomatik olarak localhost:51215'i kullanır). Bulut veritabanında boş bir veritabanı verin.
# SHADOW_DATABASE_URL=

API_PORT=4000

# Virgülle ayrılmış izinli frontend adresleri
CORS_ORIGIN="http://localhost:5180"

# --- Oturum ---
# Production'da MUTLAKA değiştirin: openssl rand -base64 48
JWT_SECRET="wayora-dev-only-secret-change-me-32-chars"
JWT_EXPIRES_IN=7d
COOKIE_NAME=wayora_session
# Production'da true (HTTPS). Development'ta boş bırakılabilir.
# COOKIE_SECURE=true

# --- AI gezi planı (Week 10: gateway / routing / fallback) ---
# offline  : API anahtarı gerekmez, deterministik yerel üretici (demo ve test için)
# gemini   : Google Gemini API
# openai   : OpenAI Chat Completions
LLM_PROVIDER=offline
# GEMINI_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL_FAST=gemini-2.0-flash
LLM_MODEL_SMART=gemini-2.5-pro
LLM_TIMEOUT_MS=20000
# Kullanıcı başına günlük AI üretim limiti
AI_DAILY_LIMIT=10

# --- Harita / yerler (opsiyonel) ---
# Anahtar yoksa uygulama yerleşik şehir kataloğuyla çalışır.
# GOOGLE_PLACES_API_KEY=

# --- Ücretsiz keşif sağlayıcıları (opsiyonel) ---
# Ticketmaster Discovery: ücretsiz API anahtarı, günde 5.000 çağrı.
# Anahtar yoksa şehir etkinlikleri bölümü kapalı kalır.
# TICKETMASTER_API_KEY=

# Duffel test modu: ücretsiz test token'ı, fiyatlar gerçek değildir.
# Canlıya geçişte Duffel ticari hesabı ve canlı token gerekir.
# DUFFEL_ACCESS_TOKEN=
DISCOVERY_TIMEOUT_MS=10000
